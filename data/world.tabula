# World generation knobs and terrain definitions, read by game/worldgen.h.
# Every knob must be present: parse fallbacks are zero on purpose, so a
# missing or misspelled key produces an obviously broken world.

world = {
  width = 128
  height = 128

  # noise fields: scale is tiles per noise-lattice cell; persistence is the
  # per-octave amplitude falloff (higher = rougher, more variation inside
  # the large forms)
  elevation_scale = 30
  elevation_octaves = 6
  elevation_persistence = 0.6
  moisture_scale = 20
  moisture_octaves = 5
  moisture_persistence = 0.7

  # temperature: piecewise-linear latitude gradient through three points
  # (equator = the map's middle row), wobbled by its own noise field, cooled
  # by altitude. The lapse is curved: normalized height above the sea raised
  # to temperature_lapse_exponent, times temperature_lapse -- exponent > 1
  # spares mid ground and freezes ridgelines sharply, so snow pins to the
  # spines even in warm latitudes.
  temperature_north = 0.12
  temperature_equator = 0.8
  temperature_south = 0.12
  temperature_variation = 0.15
  temperature_scale = 40
  temperature_octaves = 3
  temperature_persistence = 0.5
  temperature_lapse = 0.9
  temperature_lapse_exponent = 2.5

  # field anchors: sea_level says where water sits (rivers trace to it,
  # coasts test against it), drainage_ceiling is the elevation where the
  # height-above-the-water-table drainage term saturates, river_moisture
  # wets river banks before matching
  sea_level = 0.32
  drainage_ceiling = 0.62
  drainage_full_slope = 0.045 # slope (elevation per tile) that counts as fully drained
  river_moisture = 0.10

  # continental rim: the border is always deep water. Inside continent_edge
  # (distance from the border, in half-map units) the heightmap stands as
  # tuned; from there elevation blends to 0 over continent_smoothness of
  # that distance, so land can rise anywhere inland and never at the border.
  continent_edge = 0.2
  continent_smoothness = 0.85

  # tectonic plates: the map splits into fuzzy voronoi cells around blue-
  # noise seed points (one per plate_spacing-sized grid cell, so plate size
  # is map-scale independent). Each plate drifts with a random velocity;
  # borders whose relative motion presses inward become ridges. Uplift falls
  # off with distance to the nearest ridge -- warped by noise so ranges
  # pinch and wander -- and is shaped by ridged noise so crests break into
  # peaks and saddles instead of smooth walls.
  plate_spacing = 40      # mean tiles between plate seeds
  plate_fuzz = 5          # border warp amplitude, tiles; 0 = exact voronoi
  plate_fuzz_scale = 8    # tiles per warp-noise cell
  uplift_height = 0.8     # elevation added at a full-force ridge
  uplift_width = 12       # tiles from ridge spine to the foot of the falloff
  uplift_noise = 0.5      # distance warp strength, 0..1
  uplift_noise_scale = 16 # tiles per distance-warp-noise cell
  uplift_ridged = 0.6     # ridged-noise shaping blend, 0..1
  uplift_ridged_scale = 8 # tiles per ridged-noise cell

  # terrain regions smaller than this dissolve into their most common
  # neighbor after classification (0 = off): kills single-tile speck noise
  min_region_size = 4

  river_count = 12
  river_max_tries = 100  # maximum numbers of attempts at generating rivers
  river_min_length = 6   # steps; rivers that trace shorter than this are culled
  river_meander = 0.008  # descent jitter in elevation units; 0 = pure steepest descent
  pond_epsilon = 0.01  # a basin floods its connected bowl up to this height above it
  pond_max_tiles = 32  # hard cap on one pond's flood, whatever the epsilon

  # travel rule scalars forwarded onto the board
  road_cost = 0.5
  river_cross_cost = 2.0

  # Terrain rows, matched IN ORDER: a tile takes the first row whose bands
  # all contain its field values (elevation / moisture / drainage /
  # temperature, each 0..1; a missing band means "don't care", so the last
  # row catches all). The row's position is its id; name is also the art
  # prefix (<name>_ground.png etc). rank orders boundary spill: higher
  # covers lower -- softer forms over harder ones. move_cost <= 0 is
  # impassable. overlay_density is the percent of interior tiles carrying
  # overlay art -- rows with overlay art must declare it.

  terrain_type = {
    name = ice
    color = [0.78 0.86 0.93]
    rank = 3
    move_cost = 0
    elevation = [0.0 0.32]
    temperature = [0.0 0.15]
  }
  terrain_type = {
    name = ocean
    color = [0.12 0.22 0.42]
    rank = 1
    move_cost = 0
    elevation = [0.0 0.22]
  }
  terrain_type = {
    name = water
    color = [0.18 0.32 0.55]
    rank = 2
    move_cost = 0
    elevation = [0.22 0.32]
  }
  terrain_type = {
    name = snowcap
    color = [0.88 0.90 0.95]
    rank = 6
    move_cost = 0
    elevation = [0.62 1.0]
    temperature = [0.0 0.22]
  }
  terrain_type = {
    name = mountain
    color = [0.54 0.52 0.50]
    rank = 5
    move_cost = 0
    overlay_density = 80
    elevation = [0.62 1.0]
  }
  terrain_type = {
    name = hills
    color = [0.52 0.56 0.38]
    rank = 7
    move_cost = 2.0
    overlay_density = 80
    elevation = [0.55 0.62]
  }
  terrain_type = {
    name = beach
    color = [0.85 0.79 0.60]
    rank = 4
    move_cost = 1.0
    elevation = [0.32 0.34]
    needs_coast = 1
  }
  terrain_type = {
    name = badlands
    color = [0.62 0.44 0.30]
    rank = 8
    move_cost = 2.0
    moisture = [0.0 0.35]
    drainage = [0.55 1.0]
    temperature = [0.4 1.0]
  }
  terrain_type = {
    name = desert
    color = [0.78 0.70 0.48]
    rank = 9
    move_cost = 1.5
    moisture = [0.0 0.38]
    temperature = [0.4 1.0]
  }
  terrain_type = {
    name = taiga
    color = [0.20 0.35 0.28]
    rank = 13
    move_cost = 2.0
    overlay_density = 80
    moisture = [0.45 1.0]
    temperature = [0.0 0.3]
  }
  terrain_type = {
    name = tundra
    color = [0.62 0.65 0.55]
    rank = 10
    move_cost = 1.5
    temperature = [0.0 0.25]
  }
  terrain_type = {
    name = jungle
    color = [0.13 0.42 0.20]
    rank = 15
    move_cost = 3.0
    overlay_density = 85
    moisture = [0.55 1.0]
    temperature = [0.65 1.0]
  }
  terrain_type = {
    name = savanna
    color = [0.62 0.58 0.33]
    rank = 11
    move_cost = 1.0
    overlay_density = 35
    moisture = [0.35 0.55]
    temperature = [0.6 1.0]
  }
  terrain_type = {
    name = swamp
    color = [0.30 0.42 0.36]
    rank = 12
    move_cost = 3.0
    moisture = [0.6 1.0]
    drainage = [0.0 0.45]
  }
  terrain_type = {
    name = forest
    color = [0.23 0.42 0.24]
    rank = 14
