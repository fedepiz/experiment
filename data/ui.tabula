# UI style, read at startup into the ui module's stack defaults plus the
# hud's widget colors (see the Debug HUD section in main.c). Colors are
# [r g b a] in 0..1; missing keys keep built-in defaults.
#
# Theme: 'vellum & oxblood' -- the UI as a chronicle being written:
# parchment panels, brown-black ink, oxblood accent on highlights,
# aged-bronze buttons, dark inverted tooltips. Values are scheme B of the
# "Imperium -- UI color scheme proposals" artifact.

style = {
  font_size = 15

  # stack defaults
  panel_background = [0.91 0.86 0.74 0.97] # vellum
  ink = [0.16 0.12 0.08 1.0]               # brown-black text
  outline = [0.45 0.36 0.24 1.0]           # aged brown borders
  border_thickness = 1.0
  panel_corner_radius = 10.0

  # named theme colors
  muted = [0.44 0.38 0.28 1.0]  # secondary text
  accent = [0.55 0.13 0.10 1.0] # oxblood: highlight values, badges

  # buttons: aged bronze, ink text, heavy brown border
  button_background = [0.72 0.62 0.44 1.0]
  button_border_color = [0.45 0.36 0.24 1.0]
  button_border_thickness = 2.0
  button_corner_radius = 8.0

  # tooltips invert: dark ink ground, pale vellum text
  tooltip_background = [0.16 0.12 0.08 0.95]
  tooltip_text = [0.88 0.83 0.70 1.0]
  tooltip_corner_radius = 8.0
}
